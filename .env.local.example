NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SECRET=replace-with-a-unique-desk-password-at-least-4-characters
GATE_SECRET=replace-with-a-different-gate-password-at-least-4-characters
SUPER_ADMIN_SECRET=replace-with-a-third-unique-owner-password-at-least-4-characters
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep private and stable; changing it makes saved sender credentials unreadable.
MAIL_SETTINGS_KEY=replace-with-a-random-64-character-hexadecimal-key
# Optional exact public origin, e.g. https://pass.djstrinity.in
# STAFF_AUTH_ORIGIN=https://pass.djstrinity.in
GMAIL_USER=events@example.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=events@example.com
# Optional transactional SMTP provider instead of the initial Gmail sender:
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=verified-sender@your-domain.example
